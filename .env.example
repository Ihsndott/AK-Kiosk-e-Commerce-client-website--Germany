# AK Kiosk & Asian Market — Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.

# Public Store Metadata
NEXT_PUBLIC_STORE_NAME="AK Kiosk & Asian Market"
NEXT_PUBLIC_STORE_ADDRESS="Buschhausener Str. 63, 46049 Oberhausen, Germany"
NEXT_PUBLIC_STORE_CITY="Oberhausen, Germany"
NEXT_PUBLIC_STORE_PHONE="+49 208 1234567"
NEXT_PUBLIC_STORE_HOURS="Mon - Sat: 09:00 - 22:00 | Sun: 12:00 - 20:00"

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/akkiosk?retryWrites=true&w=majority
# Optional: override database name (defaults to "akkiosk")
MONGODB_DB=akkiosk

# Administrator Authentication (Stage 1 Admin Panel)
# Configure these variables to automatically seed and authenticate your store administrator.
ADMIN_EMAIL=admin@ak-kiosk.de
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Store Administrator
ADMIN_JWT_SECRET=generate_a_random_64_character_hex_secret_here

# Customer Authentication (Stage 8)
# Secret key for signing customer JWT session cookies (separate from admin).
CUSTOMER_JWT_SECRET=generate_a_random_customer_64_character_hex_secret_here

# Cloudinary Image Uploads (Stage 2 Product Management)
# Configure your Cloudinary cloud credentials for product image uploads.
# If left blank, admins can still paste direct image URLs (e.g. Unsplash or CDN links).
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Stage 3: Checkout, Orders & Payments ────────────────────────────────────

# Email Notifications (Nodemailer / SMTP)
# Required for admin notifications and customer order confirmations.
ADMIN_NOTIFICATION_EMAIL=store@ak-kiosk.de
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Stripe Payments (Optional — enables online card payments)
# Get your keys from https://dashboard.stripe.com/apikeys
# sk_test_... for test mode, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Get from https://dashboard.stripe.com/webhooks after creating a webhook endpoint
# Point the webhook to: https://yourdomain.com/api/orders/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Public key is safe to expose to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Base URL (used for Stripe success/cancel redirect URLs)
# Set to your production domain in deployment (e.g. https://ak-kiosk.de)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
